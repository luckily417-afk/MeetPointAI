# ===== MeetPoint AI 环境变量模板 =====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，禁止提交真实 Key。

# 高德地图 Web 端（JavaScript API）Key —— 用于嵌入地图
AMAP_JS_KEY=
# 高德地图 Web 端（JavaScript API）安全密钥 —— 2.0 版本服务校验用
AMAP_JS_SECURITY_CODE=
# 高德地图 Web 服务 API Key —— 用于地点搜索/地理编码/路径规划
AMAP_WEB_KEY=

# DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 可选调优项 ----
# 单次请求超时（秒）
MPAI_HTTP_TIMEOUT=12
# DeepSeek 单次对话请求超时（秒），推理模型可能较慢
MPAI_LLM_TIMEOUT=120
# 推理强度：low/high/max（low 更快更省，输出更短）
MPAI_LLM_EFFORT=low
# 高延迟阈值（毫秒），超过即标记“延迟较高”
MPAI_LATENCY_WARN_MS=2500
# DeepSeek 高延迟阈值（毫秒），推理模型天然较慢
MPAI_LLM_LATENCY_WARN_MS=60000
# 周期健康检测间隔（秒），0 表示关闭周期检测
MPAI_HEALTH_INTERVAL=60
# 推荐结果数量
MPAI_TOP_N=5
# 送入 AI 的候选上限
MPAI_MAX_CANDIDATES=20
# 送入 DeepSeek 的候选上限（过多会触发长思考导致截断）
MPAI_AI_CANDIDATES=12
# 数据库/日志目录（留空则使用 %LOCALAPPDATA%\MeetPointAI）
MPAI_DATA_DIR=
